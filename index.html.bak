<style>
/* ==========================================================
   SRI SAKTHI SAREES — Mobile-first, fast-loading stylesheet
   System fonts only (no font downloads = faster load)
   ========================================================== */
:root{
  --maroon:#8f1d3a; --maroon-d:#70142c; --maroon-soft:#fdf1f4;
  --gold:#c99a2e; --gold-l:#e8c66a; --gold-soft:#fdf6e3;
  --wa:#25d366; --wa-d:#1da851; --wa-soft:#e8f9ee;
  --bg:#faf6f0; --card:#ffffff; --ink:#2b2320; --muted:#8a7a72;
  --line:#f0e4d8; --green:#1d8a4e; --red:#d0342c;
  --r:14px; --r-sm:10px; --sh:0 6px 22px rgba(90,30,20,.09); --sh-sm:0 2px 8px rgba(90,30,20,.08);
  --font:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Noto Sans","Noto Sans Tamil",Helvetica,Arial,sans-serif;
  --topbar-h:58px;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{font-family:var(--font);background:var(--bg);color:var(--ink);line-height:1.55;font-size:16px;-webkit-tap-highlight-color:transparent;text-rendering:optimizeSpeed}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer;border:none;background:none;font-size:inherit;color:inherit}
input,select,textarea{font-family:inherit;font-size:16px;color:var(--ink)}
h1,h2,h3{line-height:1.2}
svg{display:block}
.wrap{max-width:1120px;margin:0 auto;padding:0 14px}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
.muted{color:var(--muted)}
.small{font-size:.85rem}

/* ---------- Buttons ---------- */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:48px;padding:12px 20px;border-radius:12px;font-weight:700;font-size:1rem;transition:transform .12s,box-shadow .12s,opacity .15s;text-align:center;width:100%}
.btn:active{transform:scale(.97)}
.btn[disabled]{opacity:.55;pointer-events:none}
.btn-maroon{background:linear-gradient(135deg,var(--maroon),var(--maroon-d));color:#fff;box-shadow:0 6px 16px rgba(143,29,58,.32)}
.btn-gold{background:linear-gradient(135deg,#e0b64d,var(--gold));color:#4a3200;box-shadow:0 6px 16px rgba(201,154,46,.35)}
.btn-wa{background:linear-gradient(135deg,#2ee06f,var(--wa-d));color:#fff;box-shadow:0 6px 16px rgba(37,211,102,.35)}
.btn-outline{background:#fff;border:2px solid var(--maroon);color:var(--maroon)}
.btn-ghost{background:var(--bg);color:var(--ink)}
.btn-sm{min-height:40px;padding:8px 14px;font-size:.9rem;border-radius:10px}
.btn-xl{min-height:54px;font-size:1.05rem}

/* ---------- Topbar ---------- */
.promo-strip{background:linear-gradient(90deg,var(--maroon-d),var(--maroon),var(--maroon-d));color:#ffe9b0;font-size:.78rem;font-weight:600;text-align:center;padding:7px 10px;letter-spacing:.3px;white-space:nowrap;overflow:hidden}
.promo-strip span{display:inline-block;padding-left:100%;animation:marquee 16s linear infinite}
@keyframes marquee{to{transform:translateX(-100%)}}
.topbar{position:sticky;top:0;z-index:60;background:rgba(255,255,255,.94);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
.topbar-in{display:flex;align-items:center;gap:8px;height:var(--topbar-h)}
.burger{display:flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:10px;flex:0 0 auto}
.logo{display:flex;align-items:center;gap:8px;font-weight:800;font-size:1.12rem;color:var(--maroon);letter-spacing:.2px;flex:1;min-width:0}
.logo .logo-ic{width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,var(--maroon),var(--maroon-d));display:flex;align-items:center;justify-content:center;font-size:19px;flex:0 0 auto}
.logo small{display:block;font-size:.62rem;color:var(--muted);font-weight:600;letter-spacing:1.2px;text-transform:uppercase}
.top-actions{display:flex;align-items:center;gap:2px}
.icon-btn{position:relative;display:flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:10px;color:var(--ink)}
.icon-btn:active{background:var(--maroon-soft)}
.cart-badge{position:absolute;top:2px;right:0;background:var(--gold);color:#4a3200;font-size:.68rem;font-weight:800;min-width:18px;height:18px;border-radius:9px;display:flex;align-items:center;justify-content:center;padding:0 4px;border:2px solid #fff}
.bell-dot{position:absolute;top:6px;right:7px;width:9px;height:9px;background:var(--red);border-radius:50%;border:2px solid #fff}

/* ---------- Drawer nav ---------- */
.overlay{position:fixed;inset:0;background:rgba(40,15,20,.5);z-index:80;opacity:0;pointer-events:none;transition:opacity .25s}
.overlay.show{opacity:1;pointer-events:auto}
.drawer{position:fixed;top:0;left:0;bottom:0;width:min(84vw,320px);background:#fff;z-index:90;transform:translateX(-105%);transition:transform .28s cubic-bezier(.2,.8,.2,1);display:flex;flex-direction:column;overflow-y:auto}
.drawer.show{transform:none;box-shadow:20px 0 60px rgba(0,0,0,.25)}
.drawer-head{display:flex;align-items:center;gap:10px;padding:16px;background:linear-gradient(135deg,var(--maroon),var(--maroon-d));color:#fff}
.drawer-nav{padding:10px 8px 30px}
.drawer-nav a{display:flex;align-items:center;gap:12px;padding:13px 14px;border-radius:12px;font-weight:600;font-size:.98rem}
.drawer-nav a:active{background:var(--maroon-soft)}
.drawer-nav .sub{font-size:.72rem;color:var(--muted);text-transform:uppercase;letter-spacing:1px;padding:16px 14px 6px;font-weight:700}

/* ---------- Hero ---------- */
.hero{position:relative;overflow:hidden;color:#fff;border-radius:0 0 26px 26px;margin:0 0 18px;
  background:radial-gradient(120% 90% at 85% 10%,#a03050 0%,#7c1630 42%,#57101f 100%)}
.hero::before{content:"";position:absolute;inset:0;background-image:radial-gradient(rgba(232,198,106,.22) 1.4px,transparent 1.5px);background-size:26px 26px;opacity:.5}
.hero::after{content:"";position:absolute;right:-70px;top:-70px;width:280px;height:280px;border-radius:50%;background:radial-gradient(circle,rgba(232,198,106,.35),transparent 70%)}
.hero-in{position:relative;z-index:2;padding:34px 16px 40px;max-width:1120px;margin:0 auto}
.hero-chip{display:inline-flex;align-items:center;gap:6px;background:rgba(255,255,255,.14);border:1px solid rgba(232,198,106,.5);color:#ffe9b0;font-size:.74rem;font-weight:700;padding:6px 12px;border-radius:999px;letter-spacing:.4px}
.hero h1{font-size:1.9rem;font-weight:800;margin:14px 0 8px;text-shadow:0 2px 18px rgba(0,0,0,.3)}
.hero h1 .gold{color:var(--gold-l)}
.hero p{color:#f6d9de;font-size:.95rem;max-width:34ch;margin-bottom:20px}
.hero-ctas{display:flex;gap:10px;flex-wrap:wrap}
.hero-ctas .btn{width:auto;flex:1;min-width:150px}
.hero-trust{display:flex;gap:14px;flex-wrap:wrap;margin-top:22px;font-size:.78rem;color:#f3d3d9;font-weight:600}
.hero-trust b{color:#ffe9b0}

/* ---------- Section headings & chips ---------- */
.sec{margin:26px 0}
.sec-head{display:flex;align-items:baseline;justify-content:space-between;gap:10px;margin:0 2px 12px}
.sec-head h2{font-size:1.25rem;font-weight:800;display:flex;align-items:center;gap:8px}
.sec-head h2 .tick{width:5px;height:20px;border-radius:3px;background:linear-gradient(var(--gold),var(--gold-l))}
.sec-head a{font-size:.82rem;color:var(--maroon);font-weight:700;white-space:nowrap}
.cat-chips{display:flex;gap:9px;overflow-x:auto;padding:4px 2px 10px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
.cat-chips::-webkit-scrollbar{display:none}
.chip{display:inline-flex;align-items:center;gap:7px;white-space:nowrap;padding:9px 16px;border-radius:999px;background:#fff;border:1.5px solid var(--line);font-weight:600;font-size:.88rem;color:var(--ink)}
.chip.on{background:var(--maroon);border-color:var(--maroon);color:#fff;box-shadow:0 4px 12px rgba(143,29,58,.3)}

/* ---------- Category tiles ---------- */
.cat-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.cat-tile{position:relative;border-radius:var(--r);overflow:hidden;aspect-ratio:4/3.4;display:flex;align-items:flex-end;padding:14px;color:#fff;box-shadow:var(--sh-sm);min-height:0}
.cat-tile .ct-name{font-weight:800;font-size:1rem;text-shadow:0 2px 8px rgba(0,0,0,.35);display:flex;align-items:center;gap:6px;width:100%;justify-content:space-between}
.cat-tile .ct-name span{font-size:1.15rem}
.cat-tile .ct-count{font-size:.72rem;opacity:.9;font-weight:600;display:block}
.cat-tile.ct-silk{background:linear-gradient(135deg,#a3244a,#6d0f28)}
.cat-tile.ct-cotton{background:linear-gradient(135deg,#2f7d5b,#1b5a3e)}
.cat-tile.ct-daily{background:linear-gradient(135deg,#5b8db8,#2f5d8a)}
.cat-tile.ct-wedding{background:linear-gradient(135deg,#b57f1f,#7c5207)}
.cat-tile.ct-party{background:linear-gradient(135deg,#5a3d8f,#382359)}
.cat-tile::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 30%,rgba(0,0,0,.42));pointer-events:none}
.cat-tile>*{position:relative;z-index:1}

/* ---------- Product cards ---------- */
.prow{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
.pcard{background:var(--card);border-radius:var(--r);overflow:hidden;box-shadow:var(--sh-sm);display:flex;flex-direction:column;border:1px solid var(--line)}
.pcard-img{position:relative;display:block;aspect-ratio:4/3;overflow:hidden;background:#f4ede4}
.pcard-img img{width:100%;height:100%;object-fit:cover;transition:transform .35s}
.pcard-img:active img{transform:scale(1.05)}
.pcard .badge{position:absolute;top:8px;left:8px;z-index:2;background:var(--maroon);color:#fff;font-size:.66rem;font-weight:800;padding:4px 9px;border-radius:999px;letter-spacing:.4px;text-transform:uppercase}
.pcard .badge.gold{background:linear-gradient(135deg,#e0b64d,var(--gold));color:#4a3200}
.pcard .offchip{position:absolute;top:8px;right:8px;z-index:2;background:rgba(255,255,255,.94);color:var(--green);font-size:.68rem;font-weight:800;padding:4px 8px;border-radius:999px}
.pcard-body{padding:10px 11px 12px;display:flex;flex-direction:column;gap:4px;flex:1}
.pcard-body h3{font-size:.88rem;font-weight:700;line-height:1.3;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;min-height:2.3em}
.stars{font-size:.76rem;color:#b98a12;display:flex;align-items:center;gap:4px;font-weight:600}
.stars .cnt{color:var(--muted);font-weight:500}
.price-row{display:flex;align-items:center;gap:7px;flex-wrap:wrap;margin-top:2px}
.price-row b{font-size:1.02rem;color:var(--maroon)}
.price-row s{color:var(--muted);font-size:.78rem}
.price-row .off{color:var(--green);font-size:.72rem;font-weight:800}
.pcard .p-actions{display:flex;gap:7px;margin-top:8px}
.pcard .p-actions .btn{min-height:38px;padding:7px 6px;font-size:.8rem;border-radius:9px;flex:1}
.p-actions .btn-wa{flex:0 0 auto;width:auto;padding:7px 10px}
.p-actions .btn-wa svg{width:17px;height:17px}

/* ---------- WhatsApp order banner ---------- */
.wa-banner{position:relative;overflow:hidden;border-radius:var(--r);background:linear-gradient(135deg,#128c4a,#1da851 55%,#25d366);color:#fff;padding:22px 18px;box-shadow:0 10px 26px rgba(29,168,81,.35)}
.wa-banner::after{content:"";position:absolute;right:-40px;bottom:-50px;width:190px;height:190px;border-radius:50%;background:rgba(255,255,255,.14)}
.wa-banner h3{font-size:1.18rem;font-weight:800;margin-bottom:4px}
.wa-banner p{font-size:.85rem;opacity:.95;max-width:46ch}
.wa-banner .btn{width:auto;margin-top:14px;background:#fff;color:#0d7c3d;box-shadow:0 6px 16px rgba(0,0,0,.18)}

/* ---------- Reviews ---------- */
.rev-grid{display:grid;gap:12px}
.rev{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:14px;box-shadow:var(--sh-sm)}
.rev-top{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.avatar{width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:800;color:#fff;font-size:.95rem;flex:0 0 auto}
.rev-top b{font-size:.9rem;display:block}
.rev-top small{color:var(--muted);font-size:.72rem}
.rev p{font-size:.86rem;color:#4a3f38}
.rev .stars{margin-bottom:6px}
.trust-strip{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin:6px 0 2px}
.trust-item{display:flex;align-items:center;gap:10px;background:#fff;border:1px solid var(--line);border-radius:var(--r-sm);padding:11px;font-size:.8rem;font-weight:600}
.trust-item svg{width:22px;height:22px;flex:0 0 auto;color:var(--maroon)}
.trust-item .t-sub{display:block;font-size:.68rem;color:var(--muted);font-weight:500}

/* ---------- Steps ---------- */
.steps{display:grid;grid-template-columns:1fr;gap:12px}
.step{display:flex;gap:12px;background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:14px;align-items:flex-start}
.step .n{flex:0 0 auto;width:34px;height:34px;border-radius:50%;background:var(--maroon-soft);color:var(--maroon);font-weight:800;display:flex;align-items:center;justify-content:center;font-size:.95rem}
.step b{font-size:.95rem}
.step p{font-size:.82rem;color:var(--muted);margin-top:2px}

/* ---------- Product detail ---------- */
.pd-gal{position:relative;background:#fff;border-radius:var(--r);overflow:hidden;border:1px solid var(--line)}
.pd-gal img{width:100%;aspect-ratio:4/3;object-fit:cover;cursor:zoom-in}
.pd-gal .badge{top:12px;left:12px}
.pd-info{padding:16px 2px 90px}
.pd-cat{font-size:.74rem;color:var(--maroon);font-weight:800;text-transform:uppercase;letter-spacing:1px}
.pd-info h1{font-size:1.3rem;font-weight:800;margin:6px 0 8px}
.pd-price{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap;margin:6px 0 4px}
.pd-price b{font-size:1.6rem;color:var(--maroon)}
.pd-price s{color:var(--muted)}
.pd-price .off{color:var(--green);font-weight:800;background:#e9f7ef;padding:3px 8px;border-radius:8px;font-size:.8rem}
.pd-chips{display:flex;gap:8px;flex-wrap:wrap;margin:10px 0}
.pd-chip{display:inline-flex;align-items:center;gap:6px;font-size:.74rem;font-weight:700;background:var(--gold-soft);color:#6b4c05;padding:6px 11px;border-radius:999px}
.pd-chip svg{width:14px;height:14px}
.pd-block{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:14px;margin-top:12px}
.pd-block h3{font-size:.98rem;font-weight:800;margin-bottom:8px;display:flex;align-items:center;gap:7px}
.pd-block table{width:100%;font-size:.84rem;border-collapse:collapse}
.pd-block td{padding:6px 0;border-bottom:1px dashed var(--line);vertical-align:top}
.pd-block td:last-child{text-align:right;font-weight:600}
.pd-block tr:last-child td{border-bottom:none}
.pd-block p{font-size:.84rem;color:#4a3f38}
.qty-row{display:flex;align-items:center;gap:12px;margin:14px 0}
.qty-row b{font-size:.9rem}
.qty{display:inline-flex;align-items:center;border:1.5px solid var(--line);border-radius:11px;overflow:hidden}
.qty button{width:40px;height:42px;font-size:1.2rem;font-weight:700;background:#fff;color:var(--maroon)}
.qty button:active{background:var(--maroon-soft)}
.qty span{min-width:44px;text-align:center;font-weight:800}
.pd-btns{display:grid;gap:10px}
.pd-btns .btn{width:100%}
/* sticky bottom bar (mobile product page) */
.sticky-bar{position:fixed;left:0;right:0;bottom:0;z-index:55;background:rgba(255,255,255,.97);backdrop-filter:blur(8px);border-top:1px solid var(--line);padding:9px 12px calc(9px + env(safe-area-inset-bottom));display:flex;gap:8px;align-items:center;box-shadow:0 -6px 20px rgba(60,20,20,.08)}
.sticky-bar .sb-price{line-height:1.15;white-space:nowrap}
.sticky-bar .sb-price b{font-size:1.05rem;color:var(--maroon);display:block}
.sticky-bar .sb-price small{color:var(--muted);font-size:.68rem;font-weight:600}
.sticky-bar .btn{flex:1;min-height:46px}
.sticky-bar .btn-wa{flex:0 0 auto;width:52px;padding:0;min-height:46px;border-radius:12px}
.sticky-bar .btn-wa svg{width:24px;height:24px}

/* ---------- Cart ---------- */
.cart-item{display:flex;gap:12px;background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:11px;margin-bottom:10px;position:relative}
.cart-item img{width:84px;height:63px;object-fit:cover;border-radius:9px;flex:0 0 auto}
.cart-item h4{font-size:.88rem;font-weight:700;line-height:1.3}
.cart-item .ci-price{color:var(--maroon);font-weight:800;font-size:.92rem;margin:3px 0}
.cart-item .qty{height:34px}
.cart-item .qty button{width:32px;height:34px;font-size:1.05rem}
.cart-item .qty span{min-width:36px;font-size:.9rem}
.cart-item .rm{position:absolute;top:8px;right:8px;color:var(--muted);font-size:1.1rem;width:28px;height:28px;display:flex;align-items:center;justify-content:center}
.summary{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:14px;margin-top:14px}
.summary .row{display:flex;justify-content:space-between;padding:6px 0;font-size:.9rem}
.summary .row.total{border-top:2px dashed var(--line);margin-top:6px;padding-top:12px;font-weight:800;font-size:1.05rem}
.summary .row.total b{color:var(--maroon)}
.cod-note{display:flex;gap:8px;align-items:flex-start;background:var(--gold-soft);border:1px dashed #d8b24e;border-radius:10px;padding:9px 11px;font-size:.78rem;color:#6b4c05;font-weight:600;margin-top:10px}

/* ---------- Checkout ---------- */
.steps-ui{display:flex;align-items:center;gap:6px;margin:6px 0 16px}
.step-dot{flex:1;display:flex;align-items:center;gap:6px}
.step-dot .dot{width:26px;height:26px;border-radius:50%;background:#fff;border:2px solid var(--line);color:var(--muted);font-size:.75rem;font-weight:800;display:flex;align-items:center;justify-content:center;flex:0 0 auto}
.step-dot .lbl{font-size:.72rem;font-weight:700;color:var(--muted);white-space:nowrap}
.step-dot.on .dot{background:var(--maroon);border-color:var(--maroon);color:#fff}
.step-dot.on .lbl{color:var(--maroon)}
.step-dot.done .dot{background:var(--green);border-color:var(--green);color:#fff}
.step-line{flex:1;height:2px;background:var(--line);border-radius:2px}
.step-line.on{background:var(--green)}
.form-card{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:16px;margin-bottom:14px}
.form-card h3{font-size:1rem;font-weight:800;margin-bottom:12px;display:flex;align-items:center;gap:8px}
.field{margin-bottom:12px}
.field label{display:block;font-size:.8rem;font-weight:700;margin-bottom:5px}
.field .req{color:var(--red)}
.field input,.field textarea,.field select{width:100%;border:1.5px solid var(--line);border-radius:11px;padding:12px 13px;background:#fff;outline:none;transition:border .15s}
.field input:focus,.field textarea:focus{border-color:var(--maroon)}
.field input.err,.field textarea.err{border-color:var(--red);background:#fff6f5}
.field .hint{font-size:.72rem;color:var(--muted);margin-top:4px}
.pay-grid{display:grid;gap:10px}
.pay-opt{display:flex;align-items:center;gap:12px;border:2px solid var(--line);border-radius:var(--r);padding:13px;background:#fff;cursor:pointer;transition:border .15s,background .15s}
.pay-opt:active{background:var(--maroon-soft)}
.pay-opt.on{border-color:var(--maroon);background:var(--maroon-soft)}
.pay-opt .po-ic{width:40px;height:40px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:19px;flex:0 0 auto}
.pay-opt b{font-size:.95rem;display:block}
.pay-opt small{font-size:.74rem;color:var(--muted);font-weight:500}
.pay-opt .radio{margin-left:auto;width:22px;height:22px;border-radius:50%;border:2px solid #d8c9bb;flex:0 0 auto;display:flex;align-items:center;justify-content:center}
.pay-opt.on .radio{border-color:var(--maroon)}
.pay-opt.on .radio::after{content:"";width:12px;height:12px;border-radius:50%;background:var(--maroon)}
.upi-apps{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}
.upi-app{display:inline-flex;align-items:center;gap:7px;background:#fff;border:1.5px solid var(--line);border-radius:10px;padding:8px 12px;font-size:.78rem;font-weight:700}
.qr-box{display:flex;flex-direction:column;align-items:center;background:#fff;border:1.5px dashed var(--line);border-radius:var(--r);padding:16px;margin:12px 0}
.qr-box svg{width:min(220px,62vw);height:auto}
.qr-box .upi-id{display:flex;align-items:center;gap:8px;background:var(--maroon-soft);border-radius:10px;padding:9px 12px;margin-top:10px;font-weight:700;font-size:.86rem;color:var(--maroon)}
.qr-box .copy{background:#fff;border:1.5px solid var(--maroon);color:var(--maroon);font-size:.72rem;font-weight:700;padding:5px 10px;border-radius:8px}
.upi-note{font-size:.76rem;color:var(--muted);text-align:center;line-height:1.5}
.pay-amt{display:flex;align-items:baseline;justify-content:center;gap:8px;margin:4px 0 2px}
.pay-amt b{font-size:1.9rem;color:var(--maroon)}
.pay-amt span{font-size:.85rem;color:var(--muted);font-weight:600}
.verify-note{display:flex;gap:8px;background:#e9f7ef;border:1px solid #bfe6cf;color:var(--green);font-size:.78rem;font-weight:600;border-radius:10px;padding:10px 12px;margin:10px 0}

/* ---------- Success ---------- */
.success{text-align:center;padding:26px 0 10px}
.success .tick-big{width:76px;height:76px;border-radius:50%;background:linear-gradient(135deg,#2ee06f,var(--wa-d));color:#fff;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;box-shadow:0 12px 30px rgba(37,211,102,.4);animation:pop .4s cubic-bezier(.2,1.4,.4,1)}
@keyframes pop{from{transform:scale(.4);opacity:0}to{transform:scale(1);opacity:1}}
.success h1{font-size:1.5rem;font-weight:800}
.success .oid{display:inline-block;background:var(--gold-soft);color:#6b4c05;font-weight:800;padding:7px 16px;border-radius:999px;margin:10px 0 4px;font-size:.9rem;letter-spacing:1px}
.admin-card{background:#fff;border:2px dashed #d8b24e;border-radius:var(--r);padding:14px;text-align:left;margin-top:14px}
.admin-card h3{font-size:.92rem;font-weight:800;color:#6b4c05;display:flex;gap:7px;align-items:center}
.admin-card p{font-size:.78rem;color:#7a6230;margin:6px 0 10px}

/* ---------- Static pages / admin / track ---------- */
.page{padding:10px 0 60px}
.page h1{font-size:1.35rem;font-weight:800;margin-bottom:14px}
.page .card{background:#fff;border:1px solid var(--line);border-radius:var(--r);padding:16px;margin-bottom:14px}
.page .card h3{font-size:.98rem;margin-bottom:8px}
.page .card p,.page .card li{font-size:.86rem;color:#4a3f38}
.page .card ul{padding-left:18px;margin:8px 0}
.order-card{border:1px solid var(--line);border-radius:var(--r);background:#fff;padding:13px;margin-bottom:12px}
.order-card .oc-top{display:flex;justify-content:space-between;gap:8px;align-items:center;margin-bottom:6px;flex-wrap:wrap}
.order-card .oc-top b{font-size:.9rem}
.status-pill{font-size:.68rem;font-weight:800;padding:4px 10px;border-radius:999px;text-transform:uppercase;letter-spacing:.4px}
.status-placed{background:var(--gold-soft);color:#6b4c05}
.status-confirmed{background:#e3f2fd;color:#0b5e94}
.status-shipped{background:#ede7f6;color:#5a3d8f}
.status-delivered{background:#e9f7ef;color:var(--green)}
.order-card .oc-items{font-size:.8rem;color:var(--muted);margin:4px 0}
.order-card select{border:1.5px solid var(--line);border-radius:9px;padding:8px 10px;font-size:.82rem;background:#fff;width:100%;margin-top:6px}

/* ---------- Footer ---------- */
footer{background:#3a121f;color:#e8cdd3;margin-top:30px;font-size:.86rem}
.footer-top{background:linear-gradient(135deg,#4a1526,#3a121f);border-bottom:1px solid rgba(255,255,255,.08)}
.foot-grid{display:grid;gap:22px;padding:26px 0}
.foot h4{color:#fff;font-size:.92rem;margin-bottom:10px;letter-spacing:.4px}
.foot p,.foot a{color:#d9b8c0;line-height:1.7;font-size:.84rem}
.foot a:hover{color:var(--gold-l)}
.foot .wa-link{color:#7be6a4;font-weight:700}
.foot-contact li{list-style:none;display:flex;gap:9px;margin-bottom:9px;align-items:flex-start;color:#d9b8c0;font-size:.84rem}
.foot-contact svg{width:17px;height:17px;flex:0 0 auto;margin-top:3px;color:var(--gold)}
.foot-pay{display:flex;gap:8px;flex-wrap:wrap}
.foot-pay span{background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.14);padding:5px 11px;border-radius:8px;font-size:.7rem;font-weight:700;color:#ffe9b0}
.foot-bottom{padding:16px 0;font-size:.75rem;color:#b98b97;text-align:center;border-top:1px solid rgba(255,255,255,.07)}

/* ---------- Floating WhatsApp widget ---------- */
.wa-float{position:fixed;right:14px;bottom:calc(16px + env(safe-area-inset-bottom));z-index:70;width:56px;height:56px;border-radius:50%;background:linear-gradient(135deg,#2ee06f,var(--wa-d));display:flex;align-items:center;justify-content:center;box-shadow:0 10px 26px rgba(29,168,81,.5);animation:pulse 2.4s infinite}
.wa-float svg{width:30px;height:30px;fill:#fff}
.wa-float::after{content:"";position:absolute;inset:-4px;border-radius:50%;border:2px solid rgba(37,211,102,.5);animation:pulse-ring 2.4s infinite}
@keyframes pulse{0%,100%{transform:scale(1)}50%{transform:scale(1.07)}}
@keyframes pulse-ring{0%{opacity:1;transform:scale(.9)}70%{opacity:0;transform:scale(1.35)}100%{opacity:0}}
.wa-bubble{position:fixed;right:16px;bottom:82px;z-index:69;background:#fff;border-radius:14px;box-shadow:0 10px 34px rgba(0,0,0,.18);padding:12px 14px;font-size:.8rem;font-weight:600;max-width:210px;opacity:0;transform:translateY(8px);pointer-events:none;transition:.25s}
.wa-bubble.show{opacity:1;transform:none}
.wa-bubble b{color:var(--wa-d)}
.wa-bubble .caret{position:absolute;bottom:-7px;right:22px;width:14px;height:14px;background:#fff;transform:rotate(45deg)}

/* ---------- Modals / toast ---------- */
.modal{position:fixed;inset:0;z-index:100;display:flex;align-items:flex-end;justify-content:center;padding:0}
.modal .m-back{position:absolute;inset:0;background:rgba(40,15,20,.55);opacity:0;transition:opacity .25s}
.modal .m-card{position:relative;width:100%;max-width:480px;background:#fff;border-radius:20px 20px 0 0;padding:22px 18px calc(22px + env(safe-area-inset-bottom));transform:translateY(40px);opacity:0;transition:.28s cubic-bezier(.2,.8,.2,1);max-height:88vh;overflow-y:auto;margin:0 auto}
.modal.show .m-back{opacity:1}
.modal.show .m-card{transform:none;opacity:1}
.m-close{position:absolute;top:10px;right:10px;width:34px;height:34px;border-radius:50%;background:var(--bg);display:flex;align-items:center;justify-content:center;color:var(--muted)}
.aband-item{display:flex;justify-content:space-between;font-size:.82rem;padding:6px 0;border-bottom:1px dashed var(--line)}
.toast{position:fixed;left:50%;bottom:calc(84px + env(safe-area-inset-bottom));transform:translateX(-50%) translateY(20px);background:#33261f;color:#fff;font-size:.83rem;font-weight:600;padding:11px 18px;border-radius:12px;z-index:120;opacity:0;pointer-events:none;transition:.25s;max-width:88vw;text-align:center;box-shadow:0 10px 30px rgba(0,0,0,.3)}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

/* ---------- Site-wide cart bar (mobile) ---------- */
.site-cartbar{position:fixed;left:0;right:0;bottom:0;z-index:56;background:rgba(255,255,255,.98);backdrop-filter:blur(8px);border-top:2px solid var(--maroon);display:flex;align-items:center;gap:10px;padding:9px 12px calc(9px + env(safe-area-inset-bottom));box-shadow:0 -8px 24px rgba(60,20,20,.12)}
.site-cartbar .scb-info{flex:1;min-width:0;line-height:1.2}
.site-cartbar .scb-info b{color:var(--maroon);font-size:1.05rem}
.site-cartbar .scb-info small{color:var(--muted);font-size:.7rem;font-weight:600}
.site-cartbar .btn{min-height:44px;padding:10px 16px;flex:0 0 auto}
body.cartbar-on .wa-float{bottom:calc(78px + env(safe-area-inset-bottom))}
body.pdbar-on .wa-float{bottom:calc(86px + env(safe-area-inset-bottom))}
@media(min-width:900px){.site-cartbar{display:none}}
/* ---------- Misc ---------- */
.empty{text-align:center;padding:44px 16px;color:var(--muted)}
.empty .e-ic{font-size:3rem;margin-bottom:10px}
.empty b{color:var(--ink);font-size:1.05rem;display:block;margin-bottom:4px}
.page-title{font-size:1.3rem;font-weight:800;margin:14px 0 12px}
.search-in{width:100%;border:1.5px solid var(--line);border-radius:12px;padding:12px 14px;background:#fff;outline:none;margin-bottom:12px}
.search-in:focus{border-color:var(--maroon)}
.lightbox{position:fixed;inset:0;z-index:110;background:rgba(20,5,10,.92);display:flex;align-items:center;justify-content:center;padding:20px}
.lightbox img{max-width:100%;max-height:92vh;border-radius:12px}
.lb-close{position:absolute;top:14px;right:14px;color:#fff;width:40px;height:40px;display:flex;align-items:center;justify-content:center;font-size:1.4rem;background:rgba(255,255,255,.12);border-radius:50%}
.lb-swipe{font-size:.78rem;color:#e8cdd3;text-align:center;margin-top:10px}
.reveal{opacity:0;transform:translateY(14px);transition:.4s ease}
.reveal.in{opacity:1;transform:none}

/* ---------- Tablet / desktop ---------- */
@media(min-width:600px){
  .prow{grid-template-columns:repeat(3,1fr)}
  .cat-grid{grid-template-columns:repeat(3,1fr)}
  .rev-grid{grid-template-columns:repeat(2,1fr)}
  .trust-strip{grid-template-columns:repeat(4,1fr)}
  .steps{grid-template-columns:repeat(3,1fr)}
  .hero h1{font-size:2.4rem}
  .foot-grid{grid-template-columns:repeat(3,1fr)}
}
@media(min-width:900px){
  .prow{grid-template-columns:repeat(4,1fr)}
  .cat-grid{grid-template-columns:repeat(5,1fr)}
  .rev-grid{grid-template-columns:repeat(3,1fr)}
  .pd-wrap{display:grid;grid-template-columns:1.05fr 1fr;gap:22px;align-items:start}
  .pd-info{padding:6px 0 40px}
  .sticky-bar{display:none}
  .burger{display:none}
  .desk-nav{display:flex;gap:4px;margin:0 auto}
  .desk-nav a{padding:9px 13px;border-radius:10px;font-weight:600;font-size:.9rem;white-space:nowrap}
  .desk-nav a.on{background:var(--maroon-soft);color:var(--maroon)}
  .pd-btns{grid-template-columns:1fr 1fr}
  .modal{align-items:center}
  .modal .m-card{border-radius:20px}
}
.desk-nav{display:none}
@media(prefers-reduced-motion:reduce){
  *{animation-duration:.001s!important;transition-duration:.001s!important;scroll-behavior:auto!important}
}
</style>
</head>
