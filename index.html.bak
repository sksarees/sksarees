<script src="store-data.js"></script>

<!-- ============ STORE APP ============ -->
<script>
/* ============================================================================
   SK SAREES — Home / Product / Cart / Checkout app (index.html)
   Data & helpers come from store-data.js (loaded before this script).
   ========================================================================== */
'use strict';

/* ============================ 1. ROUTER ============================ */
const app = document.getElementById('app');
function parseHash(){
  const h = location.hash.replace(/^#\/?/, '');
  const [path, qs] = h.split('?');
  return { parts: path.split('/').filter(Boolean), query: new URLSearchParams(qs || '') };
}
function router(){
  const { parts, query } = parseHash();
  const route = parts[0] || 'home';
  try{ window.scrollTo({ top:0, behavior:'instant' }); }catch(e){}
  closeDrawer(); StoreUI.closeModal();
  if (route === 'shop' || route === 'category'){ location.replace(route === 'shop' ? 'products.html' : 'products.html?cat=' + (parts[1] || '')); return; }
  if (route === 'admin'){ location.replace('admin.html'); return; }
  if      (route === 'home')     renderHome();
  else if (route === 'product')  renderProduct(parts[1]);
  else if (route === 'cart')     renderCart();
  else if (route === 'checkout') renderCheckout(query);
  else if (route === 'success')  renderSuccess(parts[1]);
  else if (route === 'track')    renderTrack(query);
  else if (route === 'returns' || route === 'privacy') renderStatic(route);
  else renderHome();
  updateNav(); renderCartBadge(); renderStickyCartBar();
}

/* ============================ 2. HOME ============================ */
function renderHome(){
  const best  = PRODUCTS.filter(p => p.badge === 'Bestseller');
  const fresh = PRODUCTS.filter(p => p.badge === 'New');
  const freshList = fresh.length ? fresh : PRODUCTS.slice(0,4);
  app.innerHTML = `
  <section class="hero">
    <div class="hero-in">
      <span class="hero-chip">🔥 ${esc(CONFIG.offerTag)}</span>
      <h1>Beautiful Sarees,<br><span class="gold">Delivered to Your Doorstep</span></h1>
      <p>Authentic Kanchipuram silk, soft cotton &amp; wedding sarees. Order in 2 minutes — pay by UPI or Cash on Delivery.</p>
      <div class="hero-ctas">
        <a class="btn btn-gold" href="products.html">🛍️ Shop Best Sellers</a>
        <a class="btn btn-wa" href="${waLink('Hi! I would like to see your saree collection & current offers.')}" target="_blank" rel="noopener">${IC.wa} Order on WhatsApp</a>
      </div>
      <div class="hero-trust"><span>⭐ <b>2,300+</b> Happy Customers</span><span>🚚 <b>Free</b> Shipping</span><span>💵 <b>COD</b> Available</span></div>
    </div>
  </section>

  <div class="wrap">
    <section class="sec" style="margin-top:4px">
      <div class="trust-strip">
        <div class="trust-item">${IC.truck}<span>Free Shipping<b class="t-sub">All over India</b></span></div>
        <div class="trust-item">${IC.ret}<span>Easy Returns<b class="t-sub">7-day replacement</b></span></div>
        <div class="trust-item">${IC.shield}<span>Secure Payments<b class="t-sub">UPI • GPay • PhonePe</b></span></div>
        <div class="trust-item">${IC.wa}<span>Instant Support<b class="t-sub">Chat on WhatsApp</b></span></div>
      </div>
    </section>

    <section class="sec">
      <div class="sec-head"><h2><span class="tick"></span>Shop by Category</h2><a href="products.html">View all →</a></div>
      <div class="cat-grid">${CATEGORIES.map(catTile).join('')}</div>
    </section>

    <section class="sec">
      <div class="sec-head"><h2><span class="tick"></span>⭐ Best Sellers</h2><a href="products.html">View all →</a></div>
      <div class="prow">${best.map(productCard).join('')}</div>
    </section>

    <section class="wa-banner">
      <h3>💬 Love WhatsApp? Order in 30 seconds!</h3>
      <p>Send us the saree you like — we will confirm availability, share photos &amp; payment options instantly. No app, no login needed.</p>
      <a class="btn" href="${waLink('Hi! I want to order sarees on WhatsApp. Please share your latest collection.')}" target="_blank" rel="noopener">${IC.wa} Chat &amp; Order Now</a>
    </section>

    <section class="sec">
      <div class="sec-head"><h2><span class="tick"></span>✨ New Arrivals</h2><a href="products.html">View all →</a></div>
      <div class="prow">${freshList.map(productCard).join('')}</div>
    </section>

    <section class="sec">
      <div class="sec-head"><h2><span class="tick"></span>💬 What Our Customers Say</h2></div>
      <div class="rev-grid">${REVIEWS.map(revCard).join('')}</div>
    </section>

    <section class="sec">
      <div class="sec-head"><h2><span class="tick"></span>How to Order</h2></div>
      <div class="steps">
        <div class="step"><span class="n">1</span><div><b>Choose your Saree</b><p>Browse categories or send us a photo on WhatsApp.</p></div></div>
        <div class="step"><span class="n">2</span><div><b>Order in 2 minutes</b><p>Guest checkout with UPI / COD — no login needed.</p></div></div>
        <div class="step"><span class="n">3</span><div><b>Doorstep delivery</b><p>Get WhatsApp updates until your saree arrives.</p></div></div>
      </div>
    </section>

    <section class="sec">
      <div class="sec-head"><h2><span class="tick"></span>🔔 Never Miss an Offer</h2></div>
      <div class="pd-block" style="display:flex;flex-wrap:wrap;gap:14px;align-items:center;justify-content:space-between">
        <div style="max-width:46ch"><b>Get new arrivals &amp; festival discounts on WhatsApp.</b>
        <p class="muted small" style="margin-top:4px">Join 500+ customers getting saree alerts before everyone else.</p></div>
        <button class="btn btn-maroon btn-sm" style="width:auto;min-width:170px" data-open-alerts>🔔 Subscribe for Alerts</button>
      </div>
    </section>
  </div>`;
}

/* ============================ 3. PRODUCT PAGE ============================ */
let pdId = null, pdQty = 1;
function renderProduct(id){
  const p = byId(id);
  if (!p) { StoreUI.toast('Sorry, that saree is no longer available'); location.replace('products.html'); return; }
  pdId = p.id; pdQty = 1;
  const off = offPct(p);
  const cat = catOf(p.cat);
  const related = PRODUCTS.filter(x => x.cat === p.cat && x.id !== p.id).slice(0,4);
  const revs = REVIEWS.slice(0,3).map(revCard).join('');
  app.innerHTML = `
  <div class="wrap pd-wrap" style="margin-top:12px">
    <div>
      <div class="pd-gal">
        ${p.badge ? `<span class="badge${p.badge === 'New' ? ' gold' : ''}">${esc(p.badge)}</span>` : ''}
        ${off ? `<span class="offchip" style="top:12px;right:12px">${off}% OFF</span>` : ''}
        <img src="${p.img}" alt="${esc(p.name)}" data-lb="${p.img}" width="800" height="600">
      </div>
      <div class="pd-block" style="margin-top:12px">
        <h3>🔍 Fabric &amp; Details</h3>
        <table>
          <tr><td>Fabric</td><td>${esc(p.fabric)}</td></tr>
          <tr><td>Length</td><td>${esc(p.length)}</td></tr>
          <tr><td>Colours</td><td>${esc(p.colors)}</td></tr>
          <tr><td>Wash care</td><td>${esc(p.wash)}</td></tr>
          <tr><td>Delivery</td><td>2–4 days (Tamil Nadu) • 4–7 days (All India)</td></tr>
        </table>
      </div>
    </div>

    <div class="pd-info">
      <span class="pd-cat">${cat ? cat.emoji + ' ' + esc(cat.name) : ''}</span>
      <h1>${esc(p.name)}</h1>
      ${starsHTML(p.rating, p.reviews)}
      <div class="pd-price"><b>${money(p.price)}</b>${p.mrp ? `<s>${money(p.mrp)}</s>` : ''}${off ? `<span class="off">${off}% OFF</span>` : ''}</div>
      <p class="muted small">MRP inclusive of all taxes • Free shipping 🚚</p>

      <div class="pd-chips">
        <span class="pd-chip">${IC.truck} Free Shipping</span>
        <span class="pd-chip">💵 COD Available (+₹${CONFIG.codFee})</span>
        <span class="pd-chip">${IC.ret} 7-Day Returns</span>
        <span class="pd-chip">${IC.pin} Made in India</span>
      </div>

      <div class="qty-row"><b>Quantity</b>
        <div class="qty"><button data-qm aria-label="Decrease quantity">−</button><span id="qtyVal">1</span><button data-qp aria-label="Increase quantity">+</button></div>
      </div>

      <div class="pd-btns">
        <button class="btn btn-outline" data-addp>🛒 Add to Cart</button>
        <a class="btn btn-maroon" href="#/checkout?buy=${p.id}">⚡ Buy Now</a>
        <a class="btn btn-wa btn-xl" href="${waLink(waProductMsg(p))}" target="_blank" rel="noopener"> Buy on WhatsApp — Instant Confirmation</a>
      </div>

      <div class="pd-block">
        <h3> 100% Safe &amp; Easy</h3>
        <p class="small muted">Pay by <b>UPI</b> (GPay / PhonePe / Paytm) or <b>Cash on Delivery</b> (+₹${CONFIG.codFee}). No account or login needed — just your name, phone &amp; address.</p>
      </div>

      <div class="pd-block">
        <h3>📖 About this Saree</h3>
        <p>${esc(p.desc)}</p>
      </div>

      <div class="pd-block">
        <h3>↩️ Easy Returns</h3>
        <p class="small">Not happy? Get a <b>free replacement within 7 days</b> for damaged / wrong / size-mismatch items. Just message us on WhatsApp with your order ID.</p>
      </div>

      <div class="pd-block">
        <h3>💬 Customer Reviews</h3>
        ${revs}
      </div>
    </div>
  </div>

  ${related.length ? `
  <div class="wrap sec">
    <div class="sec-head"><h2><span class="tick"></span>You May Also Like</h2></div>
    <div class="prow">${related.map(productCard).join('')}</div>
  </div>` : ''}

  <div class="sticky-bar">
    <div class="sb-price"><b>${money(p.price)}</b><small>${off ? off + '% off' : 'Free shipping'}</small></div>
    <a class="btn btn-outline" href="#/checkout?buy=${p.id}">Buy Now</a>
    <button class="btn btn-maroon" data-add="${p.id}">Add</button>
    <a class="btn btn-wa" href="${waLink(waProductMsg(p))}" target="_blank" rel="noopener" aria-label="Order on WhatsApp">${IC.wa}</a>
  </div>`;
}

/* ============================ 4. CART PAGE ============================ */
function renderStickyCartBar(){
  let el = document.getElementById('siteCartBar');
  const n = Store.cart.reduce((s,i) => s + i.qty, 0);
  const { parts } = parseHash();
  const hideRoutes = ['cart','checkout','success'];
  const onProduct = parts[0] === 'product';
  document.body.classList.toggle('pdbar-on', onProduct);
  const show = n > 0 && !hideRoutes.includes(parts[0]);
  document.body.classList.toggle('cartbar-on', show && !onProduct);
  if (show && !onProduct){
    if (!el){ el = document.createElement('div'); el.id = 'siteCartBar'; el.className = 'site-cartbar'; document.body.appendChild(el); }
    el.innerHTML = `<div class="scb-info"><b>${money(cartTotal())}</b><small>${n} item${n>1?'s':''} • Free shipping</small></div>
      <a class="btn btn-maroon btn-sm" href="#/checkout">Checkout</a>
      <a class="btn btn-wa btn-sm" href="${waLink(waCartMsg())}" target="_blank" rel="noopener">${IC.wa} WhatsApp</a>`;
  } else if (el){ el.remove(); }
}
function renderCart(){
  if (!Store.cart.length){
    app.innerHTML = `<div class="wrap"><div class="empty"><div class="e-ic">🛒</div><b>Your cart is empty</b>Browse our sarees and add your favourites!<br><br><a class="btn btn-maroon" style="max-width:260px;margin:0 auto" href="products.html">🛍️ Shop Sarees</a></div></div>`;
    return;
  }
  const t = cartTotal();
  const items = Store.cart.map(i => {
    const p = byId(i.id); if (!p) return '';
    return `<div class="cart-item">
      <img src="${p.img}" alt="${esc(p.name)}" loading="lazy" width="200" height="150">
      <div style="flex:1;min-width:0;padding-right:26px">
        <h4>${esc(p.name)}</h4>
        <div class="ci-price">${money(p.price)}</div>
        <div class="qty">
          <button data-cq-minus="${i.id}" aria-label="Decrease">−</button><span>${i.qty}</span>
          <button data-cq-plus="${i.id}" aria-label="Increase">+</button>
        </div>
      </div>
      <button class="rm" data-rm="${i.id}" aria-label="Remove">✕</button>
    </div>`;
  }).join('');
  app.innerHTML = `<div class="wrap page">
    <h1 class="page-title">🛒 Your Cart</h1>
    ${items}
    <div class="summary">
      <div class="row"><span>Items total</span><b>${money(t)}</b></div>
      <div class="row"><span>Shipping</span><b class="muted" style="color:var(--green)">FREE</b></div>
      <div class="row total"><span>Total</span><b>${money(t)}</b></div>
      <div class="cod-note">💵 COD Available — pay <b>&nbsp;₹${CONFIG.codFee}&nbsp;</b> extra at delivery. Choose it at checkout.</div>
      <div style="display:grid;gap:10px;margin-top:14px">
        <a class="btn btn-maroon btn-xl" href="#/checkout">Proceed to Checkout →</a>
        <a class="btn btn-wa" href="${waLink(waCartMsg())}" target="_blank" rel="noopener">${IC.wa} Order on WhatsApp Instead</a>
      </div>
      <p class="small muted" style="text-align:center;margin-top:10px">🔒 No login needed • Secure UPI &amp; COD • 7-day returns</p>
    </div>
  </div>`;
}

/* ============================ 5. CHECKOUT (2 steps) ============================ */
const co = { step: 1, data: { name:'', phone:'', address:'', pincode:'', payment:'upi' } };
const FREE_MSG = 'FREE';
function calcTotals(payment){
  const itemsTotal = cartTotal();
  const codFee = payment === 'cod' ? CONFIG.codFee : 0;
  const shipping = 0;
  return { itemsTotal, codFee, shipping, grand: itemsTotal + codFee + shipping };
}
function renderCheckout(query){
  const buy = query.get('buy');
  if (buy && !Store.cart.some(i => i.id === buy)) addToCart(buy, 1);
  if (!Store.cart.length){ StoreUI.toast('Your cart is empty'); return renderCart(); }
  const d = co.data;
  const stepsUI = `
    <div class="steps-ui">
      <div class="step-dot ${co.step > 1 ? 'done' : 'on'}"><span class="dot">${co.step > 1 ? '✓' : '1'}</span><span class="lbl">Details</span></div>
      <div class="step-line ${co.step > 1 ? 'on' : ''}"></div>
      <div class="step-dot ${co.step === 2 ? 'on' : ''}"><span class="dot">2</span><span class="lbl">Payment &amp; Confirm</span></div>
    </div>`;
  app.innerHTML = `<div class="wrap page"><h1 class="page-title">🔒 Secure Checkout</h1>${stepsUI}
    ${co.step === 1 ? coStep1(d) : coStep2(d)}</div>`;
  if (co.step === 2 && d.payment === 'upi') setTimeout(drawUpiQR, 60);
}
function coStep1(d){
  return `<div class="form-card">
    <h3>📋 Your Details <span class="muted small" style="font-weight:500">(no login needed)</span></h3>
    <div class="field"><label>Full Name <span class="req">*</span></label>
      <input id="coName" data-co="name" value="${esc(d.name)}" placeholder="e.g. Lakshmi S" autocomplete="name"></div>
    <div class="field"><label>WhatsApp / Mobile Number <span class="req">*</span></label>
      <input id="coPhone" data-co="phone" value="${esc(d.phone)}" placeholder="10-digit mobile number" inputmode="numeric" maxlength="10" autocomplete="tel">
      <div class="hint">📱 Order updates will be sent on this number via WhatsApp</div></div>
    <div class="field"><label>Complete Address <span class="req">*</span></label>
      <textarea id="coAddr" data-co="address" rows="3" placeholder="House no, street, area, city / village…" autocomplete="street-address">${esc(d.address)}</textarea></div>
    <div class="field"><label>PIN Code <span class="req">*</span></label>
      <input id="coPin" data-co="pincode" value="${esc(d.pincode)}" placeholder="6-digit PIN" inputmode="numeric" maxlength="6" autocomplete="postal-code"></div>
  </div>
  <div class="form-card">
    <h3>💳 Payment Method</h3>
    <div class="pay-grid">
      <div class="pay-opt ${d.payment === 'upi' ? 'on' : ''}" data-pay="upi" role="radio" aria-checked="${d.payment === 'upi'}">
        <span class="po-ic" style="background:#e3f2fd">📲</span>
        <span><b>UPI — Pay Online</b><small>GPay • PhonePe • Paytm • Scan QR</small></span>
        <span class="radio"></span>
      </div>
      <div class="pay-opt ${d.payment === 'cod' ? 'on' : ''}" data-pay="cod" role="radio" aria-checked="${d.payment === 'cod'}">
        <span class="po-ic" style="background:var(--gold-soft)">💵</span>
        <span><b>Cash on Delivery</b><small>Pay when it reaches you — extra ₹${CONFIG.codFee} applies</small></span>
        <span class="radio"></span>
      </div>
    </div>
  </div>
  ${d.payment === 'cod' ? `
    <button class="btn btn-wa btn-xl" data-confirm-wa>${IC.wa} Confirm Order on WhatsApp</button>
    <p class="small muted" style="text-align:center;margin-top:8px">Instant confirmation — your COD order (incl. ₹${CONFIG.codFee}) is sent to us on WhatsApp. No payment step needed.</p>`
  : `
    <button class="btn btn-maroon btn-xl" data-cont>Continue to Payment →</button>
    <p class="small muted" style="text-align:center;margin-top:10px">🔒 100% secure • We never store card details</p>`}`;
}
function coStep2(d){
  const t = calcTotals(d.payment);
  const itemLines = Store.cart.map(i => { const p = byId(i.id); return p ? `<div class="row"><span>${esc(p.name)} ×${i.qty}</span><b>${money(p.price * i.qty)}</b></div>` : ''; }).join('');
  const upiPay = d.payment === 'upi';
  return `<div class="form-card">
    <h3>🧾 Review Your Order</h3>
    ${itemLines}
    <div class="row"><span>Shipping</span><b style="color:var(--green)">${FREE_MSG}</b></div>
    ${upiPay ? '' : `<div class="row"><span>COD charges</span><b>+${money(t.codFee)}</b></div>`}
    <div class="row total"><span>Total ${upiPay ? '' : '(incl. COD ₹' + CONFIG.codFee + ')'}</span><b>${money(t.grand)}</b></div>
    <div class="row"><span style="color:var(--muted);font-size:.8rem">Deliver to</span></div>
    <p class="small" style="border:1px dashed var(--line);border-radius:10px;padding:10px;background:var(--bg)">
      <b>${esc(d.name)}</b> • ${esc(d.phone)}<br>${esc(d.address)} — ${esc(d.pincode)}</p>
  </div>

  ${upiPay ? `
  <div class="form-card">
    <h3>📲 Pay by UPI</h3>
    <div class="pay-amt"><b>${money(t.grand)}</b><span>payable</span></div>
    <div class="upi-apps">
      <span class="upi-app">🟢 GPay</span><span class="upi-app">🔵 PhonePe</span><span class="upi-app">🔴 Paytm</span>
      <span class="upi-app">🏦 Any UPI App</span>
    </div>
    <div class="qr-box">
      <div id="upiQR"></div>
      <div class="upi-id">${esc(CONFIG.upiId)} <button class="copy" data-copy="${esc(CONFIG.upiId)}">Copy</button></div>
    </div>
    <a class="btn btn-gold btn-xl" href="${upiLink(t.grand, 'Saree order')}" id="payNowBtn">📲 Pay Now — Open UPI App</a>
    <p class="upi-note" style="margin-top:10px">Scan the QR <b>or</b> tap “Pay Now” to pay ${money(t.grand)} directly from GPay / PhonePe / Paytm.<br>If the app doesn’t open, copy the UPI ID above and pay manually.</p>
    <div class="verify-note">✅ After paying, tap the button below. We will verify your payment and confirm your order on WhatsApp within minutes.</div>
    <button class="btn btn-maroon btn-xl" data-place="upi">✅ I’ve Paid — Confirm My Order</button>
  </div>` : `
  <div class="form-card">
    <h3>💵 Cash on Delivery</h3>
    <div class="pay-amt"><b>${money(t.grand)}</b><span>pay at delivery</span></div>
    <div class="cod-note">💵 COD Available (Extra <b>₹${CONFIG.codFee}</b> charges apply) — already added above.</div>
    <p class="upi-note" style="margin:10px 0">Keep ${money(t.grand)} ready when your saree arrives. Please check the parcel before paying.</p>
    <button class="btn btn-maroon btn-xl" data-place="cod">✅ Place Order — Pay on Delivery</button>
  </div>`}
  <button class="btn btn-ghost" data-back>← Back to edit details</button>
  <p class="small muted" style="text-align:center;margin-top:10px">By ordering you agree to our <a href="#/returns" style="text-decoration:underline">Return Policy</a></p>`;
}

/* ---------- UPI deep link + QR ---------- */
function upiLink(amount, note){
  /* Keep pa raw (UPI IDs contain '@' — most UPI apps expect it un-encoded) */
  return 'upi://pay?pa=' + CONFIG.upiId +
    '&pn=' + encodeURIComponent(CONFIG.upiName) +
    '&am=' + Number(amount).toFixed(2) +
    '&cu=INR&tn=' + encodeURIComponent(note || 'Saree order') + '&mode=02';
}
function drawUpiQR(){
  const box = document.getElementById('upiQR'); if (!box || !box.dataset.done){
    if (box) box.dataset.done = '1';
    const t = calcTotals('upi');
    try{
      const qr = qrcode(0, 'M');
      qr.addData(upiLink(t.grand, 'Saree order'));
      qr.make();
      box.innerHTML = qr.createSvgTag({ cellSize: 4, margin: 0, scalable: true });
    }catch(e){ box.innerHTML = '<p class="small muted">Scan unavailable — use “Pay Now” or the UPI ID.</p>'; }
  }
}

/* ---------- COD: confirm straight on WhatsApp (no payment step) ---------- */
function confirmOrderOnWhatsApp(){
  const d = co.data;
  if (!validateCo1()) return;
  const t = calcTotals('cod');
  const order = {
    id: genOrderId(),
    date: new Date().toISOString(),
    items: Store.cart.map(i => ({ id: i.id, name: byId(i.id).name, price: byId(i.id).price, qty: i.qty })),
    customer: { name: d.name.trim(), phone: d.phone.trim(), address: d.address.trim(), pincode: d.pincode.trim() },
    payment: 'cod', totals: t, status: 'placed',
  };
  Store.orders.unshift(order); Store.saveOrders();
  pushWebhook(order);
  Firestore.saveOrder(order).then(ok => { if (ok) console.log('[SK SAREES] Order synced to Firestore:', order.id); });
  Store.cart = []; Store.saveCart();
  LS.set('ss_abandon', null);
  /* Open WhatsApp to the STORE with the full COD order — customer just taps Send */
  const msg = `Hi! I want to confirm my COD order:\n\n🪡 Order ID: ${order.id}\n👤 Name: ${order.customer.name}\n📱 Phone: ${order.customer.phone}\n🏠 Address: ${order.customer.address}, ${order.customer.pincode}\n\nItems:\n${order.items.map(i => '• ' + i.name + ' ×' + i.qty + ' — ' + money(i.price * i.qty)).join('\n')}\n\nTotal (incl. COD ₹${CONFIG.codFee}): ${money(t.grand)}\n\nPlease confirm my order. Thank you!`;
  try{ window.open(waLink(msg), '_blank', 'noopener'); }catch(e){}
  location.hash = '#/success/' + order.id + '?wa=1';
}

/* ---------- Place order ---------- */
function placeOrder(payment){
  const d = co.data;
  if (!d.name || !validPhone(d.phone) || !d.address || !/^\d{6}$/.test(d.pincode || '')){ StoreUI.toast('Please fill all details correctly'); co.step = 1; renderCheckout(parseHash().query); return; }
  const t = calcTotals(payment);
  const order = {
    id: genOrderId(),
    date: new Date().toISOString(),
    items: Store.cart.map(i => ({ id: i.id, name: byId(i.id).name, price: byId(i.id).price, qty: i.qty })),
    customer: { name: d.name.trim(), phone: d.phone.trim(), address: d.address.trim(), pincode: d.pincode.trim() },
    payment, totals: t,
    status: payment === 'upi' ? 'confirmed' : 'placed',
  };
  Store.orders.unshift(order); Store.saveOrders();
  pushWebhook(order);
  /* 💾 Firebase/Firestore: sync order to the cloud (best-effort, no blocking) */
  Firestore.saveOrder(order).then(ok => { if (ok) console.log('[SK SAREES] Order synced to Firestore:', order.id); });
  Store.cart = []; Store.saveCart();
  LS.set('ss_abandon', null);
  location.hash = '#/success/' + order.id;
}
function pushWebhook(order){
  if (!CONFIG.webhookUrl) return;
  try{ fetch(CONFIG.webhookUrl, { method:'POST', headers:{ 'Content-Type':'application/json' }, body: JSON.stringify(order) }).catch(()=>{}); }catch(e){}
}

/* ============================ 6. SUCCESS PAGE ============================ */
function renderSuccess(id){
  const o = Store.orders.find(x => x.id === id);
  if (!o) return renderHome();
  const viaWa = parseHash().query.get('wa') === '1'; /* order confirmed on WhatsApp by customer */
  const t = o.totals;
  const items = o.items.map(i => `<div class="row"><span>${esc(i.name)} ×${i.qty}</span><b>${money(i.price * i.qty)}</b></div>`).join('');
  app.innerHTML = `<div class="wrap">
    <div class="success">
      <div class="tick-big"><svg width="38" height="38" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg></div>
      <h1>${viaWa ? '🎉 Order Sent on WhatsApp!' : '🎉 Order Placed Successfully!'}</h1>
      <span class="oid">Order ID: ${o.id}</span>
      <p class="muted small" style="max-width:46ch;margin:8px auto 0">${viaWa
        ? 'WhatsApp is opening with your <b>COD order details</b> — just tap <b>Send</b> to confirm. We will reply within minutes! 💬'
        : 'Our team will <b>confirm your order on WhatsApp</b> within a few minutes. Keep your phone handy! 📱'}</p>
    </div>

    <div class="summary" style="margin-top:6px">
      ${items}
      <div class="row"><span>Shipping</span><b style="color:var(--green)">${FREE_MSG}</b></div>
      ${o.payment === 'cod' ? `<div class="row"><span>COD charges</span><b>+${money(t.codFee)}</b></div>` : ''}
      <div class="row total"><span>Total (${o.payment === 'upi' ? 'UPI' : 'COD'})</span><b>${money(t.grand)}</b></div>
      <div class="row"><span style="color:var(--muted);font-size:.8rem">Deliver to</span></div>
      <p class="small" style="border:1px dashed var(--line);border-radius:10px;padding:10px;background:var(--bg)">
        <b>${esc(o.customer.name)}</b> • ${esc(o.customer.phone)}<br>${esc(o.customer.address)} — ${esc(o.customer.pincode)}</p>
    </div>

    ${viaWa ? `
    <div class="admin-card" style="border:2px solid var(--wa);background:var(--wa-soft)">
      <h3 style="color:#0d7c3d">💬 Send Your Order on WhatsApp</h3>
      <p>Your order details are ready in WhatsApp (total <b>${money(t.grand)}</b>, COD). Tap <b>Send</b> there to confirm — then we will reply within minutes! 🎉</p>
      <div style="display:grid;gap:8px">
        <a class="btn btn-wa btn-xl" href="${waLink('Hi! I want to confirm my COD order ' + o.id + '. Please confirm.')}" target="_blank" rel="noopener">${IC.wa} Open WhatsApp &amp; Send</a>
      </div>
    </div>` : `
    <div class="admin-card" style="border:2px solid var(--wa);background:var(--wa-soft)">
      <h3 style="color:#0d7c3d">📲 Send Confirmation — Straight to Customer's WhatsApp</h3>
      <p>WhatsApp opens with the confirmation message ready for <b>${esc(o.customer.phone)}</b>. Just press <b>Send</b> — one tap and the customer is confirmed! 🎉</p>
      <div style="display:grid;gap:8px">
        <a class="btn btn-wa btn-xl" href="${waLink(TPL_CONFIRM(o), o.customer.phone)}" target="_blank" rel="noopener">${IC.wa} Send Confirmation to Customer Now</a>
      </div>
      <p class="small" id="autoConfNote" style="margin:8px 0 0;text-align:center">Auto-opening WhatsApp in <b id="autoConfSecs">3</b>… (tap the button above anytime)</p>
    </div>

    <div class="admin-card">
      <h3>📣 Store Owner — More Actions</h3>
      <p>Notify the store about this order, copy the text, or manage all orders in the admin panel.</p>
      <div style="display:grid;gap:8px">
        <a class="btn btn-outline btn-sm" href="${waLink(TPL_NOTIFY(o))}" target="_blank" rel="noopener">${IC.wa} Notify Store about this Order</a>
        <button class="btn btn-ghost btn-sm" data-copy-tpl="${esc(TPL_CONFIRM(o))}">📋 Copy Confirmation Text</button>
        <a class="btn btn-gold btn-sm" href="admin.html">🛠️ Open Store Admin (orders &amp; products)</a>
      </div>
    </div>`}

    <div style="display:grid;gap:10px;margin-top:16px;grid-template-columns:1fr 1fr">
      <a class="btn btn-maroon" href="products.html">Continue Shopping</a>
      <a class="btn btn-wa" href="${waLink('Hi! I just placed order ' + o.id + '. Please confirm it.')}" target="_blank" rel="noopener">${IC.wa} Chat with Us</a>
    </div>
  </div>`;

  /* 🤖 AUTO-SEND confirmation straight to the customer's WhatsApp number.
     Opens wa.me/<customer phone> with the confirmation text pre-filled —
     the store owner just presses Send. Runs once per order.
     Skipped when the customer already confirmed via WhatsApp (?wa=1). */
  if (viaWa) return;
  const autoKey = 'ss_conf_sent_' + o.id;
  if (!LS.get(autoKey, false)){
    LS.set(autoKey, true);
    const confHref = waLink(TPL_CONFIRM(o), o.customer.phone);
    let secs = 3;
    const timer = setInterval(() => {
      secs--;
      const el = document.getElementById('autoConfSecs');
      if (el) el.textContent = secs;
      if (secs <= 0){
        clearInterval(timer);
        try{ window.open(confHref, '_blank', 'noopener'); }catch(e){}
        const note = document.getElementById('autoConfNote');
        if (note) note.innerHTML = '📲 WhatsApp opened — press <b>Send</b> to confirm the order.';
      }
    }, 1000);
  }
}

/* ============================ 7. TRACK ORDER ============================ */
function renderTrack(query){
  let found = null;
  if (query.get('id')) found = Store.orders.find(o => o.id.toLowerCase() === query.get('id').toLowerCase());
  const resultHTML = found
    ? `<div class="form-card"><h3>📦 Order #${found.id}</h3>
        <div class="oc-items" style="margin:4px 0">${fmtDate(found.date)} • ${esc(found.customer.name)} • ${money(found.totals.grand)} (${found.payment.toUpperCase()})</div>
        <span class="status-pill status-${found.status}">${esc(found.status.replace('_',' '))}</span>
        <p class="small muted" style="margin-top:10px">Questions? Message us on WhatsApp with your order ID — we reply within minutes.</p>
        <a class="btn btn-wa btn-sm" style="margin-top:10px" href="${waLink('Hi! I want to track my order ' + found.id + '.')}" target="_blank" rel="noopener">${IC.wa} Ask on WhatsApp</a>
      </div>`
    : (query.get('id') ? `<div class="empty"><div class="e-ic">🔍</div><b>Order not found on this device</b>Orders placed from this browser are shown here. For live tracking across devices, Firestore must be enabled.</div>` : '');
  app.innerHTML = `<div class="wrap page"><h1 class="page-title">📦 Track Your Order</h1>
    <form class="form-card" id="trackForm">
      <div class="field"><label>Order ID</label><input id="trackId" placeholder="e.g. SSK1A2B3C" value="${esc(query.get('id') || '')}"></div>
      <button class="btn btn-maroon" type="submit">Track Order</button>
    </form>
    ${resultHTML}
    <div class="admin-card"><h3>🚚 Delivery Reminder (for store)</h3>
      <p>Copy &amp; send to the customer when the courier is out for delivery:</p>
      <button class="btn btn-outline btn-sm" data-copy-tpl="🚚 Your beautiful Saree is out for delivery! Track your order here. Thank you for shopping with us. 🪡">📋 Copy Template</button>
    </div></div>`;
}

/* ============================ 8. STATIC PAGES ============================ */
function renderStatic(page){
  const c = page === 'returns'
    ? { title:'↩️ Return &amp; Exchange Policy', body:`
      <p><b>7-Day Easy Replacement</b></p><ul>
      <li>Items damaged in transit, wrong item, or mismatch with order can be replaced <b>free within 7 days</b> of delivery.</li>
      <li>Message us on WhatsApp (${CONFIG.waDisplay}) with your Order ID and a photo of the issue.</li>
      <li>Replacement is dispatched after we receive/verify the return.</li>
      <li>Colour may vary slightly from photos due to screen settings — this is not a defect.</li>
      <li>COD orders: keep the invoice; verification is done by our WhatsApp support.</li>
      <li>Custom / stitched items are non-returnable unless damaged.</li></ul>` }
    : { title:'🔒 Privacy Policy', body:`
      <p>We respect your privacy. Here’s what we do with your information:</p><ul>
      <li>We collect only your <b>name, phone number, address &amp; PIN</b> to deliver your order.</li>
      <li>Your data is used only for order processing &amp; WhatsApp updates — never sold or shared.</li>
      <li>Payments happen through UPI/your bank — we never see or store card details.</li>
      <li>Opt-out of WhatsApp alerts anytime by replying “STOP” or messaging us.</li>
      <li>Contact: ${CONFIG.waDisplay} • 2/130, Thoothanoor, Edanganasalai, Salem 637502.</li></ul>` };
  app.innerHTML = `<div class="wrap page"><h1 class="page-title">${c.title}</h1><div class="card">${c.body}</div>
    <a class="btn btn-maroon" href="${waLink('Hi! I have a question about the ' + (page === 'returns' ? 'return policy' : 'privacy policy') + '.')}" target="_blank" rel="noopener">${IC.wa} Ask us on WhatsApp</a></div>`;
}

/* ============================ 9. EVENTS ============================ */
function onDocClick(e){
  if (e.target.id === 'alertGo'){ subscribeAlerts(); return; }
  const t = e.target.closest('[data-add],[data-addp],[data-qm],[data-qp],[data-cq-minus],[data-cq-plus],[data-rm],[data-cont],[data-back],[data-place],[data-pay],[data-confirm-wa],[data-copy],[data-copy-tpl],[data-open-alerts],[data-close],[data-lb]');
  if (!t) return;
  const has = k => t.dataset[k] !== undefined;
  if (has('add')){ e.preventDefault(); addToCart(t.dataset.add, 1); }
  else if (has('addp')){ e.preventDefault(); addToCart(pdId, pdQty); }
  else if (has('qm')){ if (pdQty > 1) pdQty--; const v = document.getElementById('qtyVal'); if (v) v.textContent = pdQty; }
  else if (has('qp')){ if (pdQty < 10) pdQty++; const v = document.getElementById('qtyVal'); if (v) v.textContent = pdQty; }
  else if (has('cqMinus')){ e.preventDefault(); setCartQty(t.dataset.cqMinus, parseInt(t.closest('.cart-item').querySelector('.qty span').textContent, 10) - 1); renderCart(); }
  else if (has('cqPlus')){ e.preventDefault(); setCartQty(t.dataset.cqPlus, parseInt(t.closest('.cart-item').querySelector('.qty span').textContent, 10) + 1); renderCart(); }
  else if (has('rm')){ e.preventDefault(); removeFromCart(t.dataset.rm); renderCart(); }
  else if (has('cont')){ e.preventDefault(); if (validateCo1()){ co.step = 2; renderCheckout(parseHash().query); } }
  else if (has('confirmWa')){ e.preventDefault(); confirmOrderOnWhatsApp(); }
  else if (has('back')){ e.preventDefault(); co.step = 1; renderCheckout(parseHash().query); }
  else if (has('place')){ e.preventDefault(); placeOrder(t.dataset.place); }
  else if (has('pay')){ e.preventDefault(); co.data.payment = t.dataset.pay; renderCheckout(parseHash().query); }
  else if (has('copy')){ e.preventDefault(); StoreUI.copyText(t.dataset.copy); }
  else if (has('copyTpl')){ e.preventDefault(); StoreUI.copyText(t.dataset.copyTpl); }
  else if (has('openAlerts')){ e.preventDefault(); openAlertsModal(); }
  else if (has('close')){ StoreUI.closeModal(); }
  else if (has('lb')){ showLightbox(t.dataset.lb); }
}
function validateCo1(){
  const d = co.data;
  let ok = true;
  const setErr = (id, bad) => { const el = document.getElementById(id); if (el) el.classList.toggle('err', bad); };
  if (d.name.trim().length < 2){ setErr('coName', true); ok = false; } else setErr('coName', false);
  if (!validPhone(d.phone)){ setErr('coPhone', true); ok = false; } else setErr('coPhone', false);
  if (d.address.trim().length < 10){ setErr('coAddr', true); ok = false; } else setErr('coAddr', false);
  if (!/^\d{6}$/.test(d.pincode || '')){ setErr('coPin', true); ok = false; } else setErr('coPin', false);
  if (!ok) StoreUI.toast('⚠️ Please fill the highlighted fields correctly');
  return ok;
}
function showLightbox(src){
  const box = document.createElement('div');
  box.className = 'lightbox';
  box.innerHTML = `<button class="lb-close" aria-label="Close">✕</button><img src="${src}" alt="Saree close-up"><div class="lb-swipe">Tap anywhere to close</div>`;
  box.addEventListener('click', () => box.remove());
  document.body.appendChild(box); document.body.style.overflow = 'hidden';
  box.querySelector('img').addEventListener('click', ev => ev.stopPropagation());
}
function onDocInput(e){
  const t = e.target;
  if (t.dataset.co){ co.data[t.dataset.co] = t.value; }
  if (t.id === 'alertPhone' && t.classList) t.classList.remove('err');
}
function updateNav(){
  const { parts } = parseHash();
  document.querySelectorAll('.desk-nav a').forEach(a => {
    a.classList.toggle('on', a.getAttribute('href') === '#/' + parts[0]);
  });
}
function openDrawer(){ document.getElementById('drawer').classList.add('show'); document.getElementById('overlay').classList.add('show'); document.getElementById('btnMenu').setAttribute('aria-expanded','true'); }
function closeDrawer(){ document.getElementById('drawer').classList.remove('show'); document.getElementById('overlay').classList.remove('show'); document.getElementById('btnMenu').setAttribute('aria-expanded','false'); }

/* ============================ 10. INIT ============================ */
function init(){
  document.getElementById('btnMenu').addEventListener('click', openDrawer);
  document.getElementById('overlay').addEventListener('click', closeDrawer);
  document.getElementById('drawerNav').addEventListener('click', e => { if (e.target.closest('a')) closeDrawer(); });
  document.getElementById('btnAlerts').addEventListener('click', openAlertsModal);
  document.addEventListener('click', onDocClick);
  document.addEventListener('input', onDocInput);
  window.addEventListener('hashchange', router);
  document.addEventListener('submit', e => {
    if (e.target.id === 'trackForm'){
      e.preventDefault();
      const id = (document.getElementById('trackId') || {}).value || '';
      location.hash = '#/track?id=' + encodeURIComponent(id);
    }
  });
  if (!LS.get('ss_wa_tip', 0)){
    LS.set('ss_wa_tip', 1);
    setTimeout(() => { const b = document.getElementById('waBubble'); if (b) b.classList.add('show'); }, 2500);
    setTimeout(() => { const b = document.getElementById('waBubble'); if (b) b.classList.remove('show'); }, 10000);
  }
  router();
  renderCartBadge();
  renderStickyCartBar();
  setTimeout(checkAbandon, 2000);
  setInterval(checkAbandon, 20000);
}
document.addEventListener('DOMContentLoaded', init);

</script>
</body>
</html>
