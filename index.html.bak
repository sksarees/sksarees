<!-- ============ QR CODE LIBRARY (MIT, inlined for offline speed) ============ -->
<script>/**
 * Minified by jsDelivr using Terser v5.37.0.
 * Original file: /npm/qrcode-generator@1.4.4/qrcode.js
 *
